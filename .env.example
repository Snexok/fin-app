# Production (Vercel): обязателен Postgres. Без него /api/health отвечает 503, а API — 503 DB_UNAVAILABLE.
DATABASE_URL=              # Postgres (POSTGRES_URL тоже подхватывается). TLS с проверкой сертификата.
DATABASE_SSL=              # "disable" только для локального/частного Postgres без TLS; "require" — форсировать TLS
DATABASE_POOL_MAX=5
MOZHNO_AUTO_MIGRATE=       # 1 = применять миграции при первом подключении (иначе: npm run db:migrate)

# Локально без DATABASE_URL используется PGlite (Postgres в WASM) в ./.data/pglite.
# В production PGlite включается только явно: MOZHNO_DB=pglite (не рекомендуется, данные не переживут деплой).
MOZHNO_DB=
PGLITE_DIR=                # каталог PGlite или memory://

OPENAI_API_KEY=            # LLM (классификация намерения, короткое вступление) + STT
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=              # любой OpenAI-совместимый провайдер (опционально)
LLM_API_KEY=               # ключ для LLM_BASE_URL, если отличается от OPENAI_API_KEY
STT_MODEL=whisper-1

TELEGRAM_BOT_TOKEN=        # один секрет <id>:<secret> (формат проверяется; невалидный игнорируется)
# ВРЕМЕННО (удалить): TELEGRAM_BOT_ID / TELEGRAM_BOT_KEY / TELEGRAM_BOT_KEY2 / TELEGRAM_BOT_TOKEN_B64 читаются,
# только если TELEGRAM_BOT_TOKEN не задан или невалиден. Не используйте их в новых окружениях.
TELEGRAM_BOT_USERNAME=     # без @; нужен для deep link привязки t.me/<bot>?start=link_<код>
TELEGRAM_WEBHOOK_SECRET=   # обязателен в production (без него вебхук отвечает 503)

STT_API_KEY=               # ключ STT, если отличается от OPENAI_API_KEY
STT_BASE_URL=              # OpenAI-совместимый STT (по умолчанию https://api.openai.com/v1)

APP_ORIGIN=                # разрешённые Origin через запятую, например https://mozhno.app (иначе схема+Host запроса)
TRUST_PROXY=               # vercel (по умолчанию на Vercel) | число доверенных прокси | none
CRON_SECRET=               # включает /api/cron/cleanup (Vercel Cron: Authorization: Bearer <CRON_SECRET>)
