# Production (Vercel): обязателен Postgres. Без него /api/health отвечает 503, а API — 503 DB_UNAVAILABLE.
DATABASE_URL=              # Postgres (POSTGRES_URL тоже подхватывается). TLS с проверкой сертификата.
DATABASE_SSL=              # "disable" только для локального/частного Postgres без TLS; "require" — форсировать TLS
DATABASE_POOL_MAX=5
MOZHNO_AUTO_MIGRATE=       # 1 = применять миграции при первом подключении (иначе: npm run db:migrate)

# Локально без DATABASE_URL используется PGlite (Postgres в WASM) в ./.data/pglite.
# В production PGlite включается только явно: MOZHNO_DB=pglite (не рекомендуется, данные не переживут деплой).
MOZHNO_DB=
PGLITE_DIR=                # каталог PGlite или memory://

# LLM (lib/llm): только разбор намерения, когда regex не уверен; числа всегда считает движок. Без ключа — regex и шаблоны.
LLM_BASE_URL=              # OpenAI-совместимый шлюз; прокси акселератора: https://shared1.multitool.works:4000/v1
LLM_API_KEY=               # ключ шлюза (accelerator-…); OPENAI_API_KEY тоже подхватывается
OPENAI_API_KEY=            # прежний вариант: чистый OpenAI (без LLM_BASE_URL модель по умолчанию gpt-4o-mini) + STT
LLM_MODEL_PRIMARY=         # по умолчанию со шлюзом: gigachat3.5-432b-a28b (прежнее имя LLM_MODEL тоже читается)
LLM_MODEL_FALLBACKS=       # через запятую; по умолчанию со шлюзом: qwen3.5-397b-a17b,deepseek-v4-pro
LLM_MODEL_INTENT=          # малая модель для разбора намерения (опционально), цепочка: она → основная → резервные
LLM_ENABLED=               # 0 — выключатель: ни одного вызова модели, всё на шаблонах
LLM_DAILY_BUDGET_RUB=      # жёсткий потолок проекта в день (МСК), по умолчанию 2850
LLM_USER_DAILY_SOFT_CAP_RUB= # мягкий лимит пользователя в день, по умолчанию 3 (0 — без лимита)
LLM_TOTAL_BUDGET_RUB=      # весь бюджет акселератора, по умолчанию 50000
LLM_TOTAL_BUDGET_MAX_RUB=  # расширенный бюджет (только показ на дашборде), по умолчанию 75000
LLM_BUDGET_START=          # YYYY-MM-DD: с какого дня считается весь бюджет
LLM_TIMEOUT_MS=            # таймаут одной попытки, по умолчанию 8000; LLM_TOTAL_TIMEOUT_MS — всей цепочки (15000)
LLM_MAX_OUTPUT_TOKENS=     # потолок max_tokens на вызов, по умолчанию 800; LLM_MAX_INPUT_CHARS — длина входа (6000)
LLM_PRICES=                # JSON: {"модель":[вход,выход]} коп. за 1 млн токенов с НДС — переопределить таблицу цен
LLM_PRICE_MARKUP=          # коэффициент комиссии прокси к ценам Cloud.ru, по умолчанию 1
LLM_JSON_MODE=             # 0 — не отправлять response_format json_object (если шлюз его не поддерживает)
STT_MODEL=whisper-1
STT_PRICE_KOP_PER_SEC=     # цена голоса, по умолчанию 0.61 коп./с

TELEGRAM_BOT_TOKEN=        # один секрет <id>:<secret> (формат проверяется; невалидный игнорируется)
# ВРЕМЕННО (удалить): TELEGRAM_BOT_ID / TELEGRAM_BOT_KEY / TELEGRAM_BOT_KEY2 / TELEGRAM_BOT_TOKEN_B64 читаются,
# только если TELEGRAM_BOT_TOKEN не задан или невалиден. Не используйте их в новых окружениях.
TELEGRAM_BOT_USERNAME=     # без @; нужен для deep link привязки t.me/<bot>?start=link_<код>
TELEGRAM_WEBHOOK_SECRET=   # обязателен в production (без него вебхук отвечает 503)

STT_API_KEY=               # ключ STT, если отличается от OPENAI_API_KEY
STT_BASE_URL=              # OpenAI-совместимый STT (по умолчанию https://api.openai.com/v1; при одном LLM_API_KEY — LLM_BASE_URL)

APP_ORIGIN=                # разрешённые Origin через запятую, например https://mozhno.app (иначе схема+Host запроса)
TRUST_PROXY=               # vercel (по умолчанию на Vercel) | число доверенных прокси | none
CRON_SECRET=               # включает /api/cron/cleanup (Vercel Cron: Authorization: Bearer <CRON_SECRET>)

# Тарифы и AI-ответы (миграция 010). Этап 1: оплаты нет, у всех Бета-Плюс.
PLANS_MODE=                # beta (по умолчанию) | live
BETA_ENDS_AT=              # YYYY-MM-DD последний день беты (МСК), опционально
BETA_AI_ANSWERS_PER_DAY=   # 15; BETA_AI_ANSWERS_PER_30D — 0 (без лимита)
FREE_AI_ANSWERS_PER_DAY=   # 10; FREE_AI_ANSWERS_PER_30D — 60; FREE_VOICE_MIN_PER_30D — 2; FREE_VOICE_MIN_PER_DAY — 0
PLUS_AI_ANSWERS_PER_DAY=   # 30; PLUS_AI_ANSWERS_PER_30D — 300; PLUS_VOICE_MIN_PER_30D — 30; PLUS_VOICE_MIN_PER_DAY — 3
PLANS_WINDOW_DAYS=         # 30
PLUS_PRICE_RUB=            # 399 (показывается «после беты», без автопродления); PLUS_PERIOD_DAYS — 30
PLUS_PRICE_OPTIONS=        # 299,399,499 — варианты честной цены в заявке
PLUS_PRICE_EXPERIMENT=     # 1 — каждому стабильно показывать одну цену из PLUS_PRICE_OPTIONS
PLANS_RESERVATION_TTL_SEC= # 120; PLANS_LOW_THRESHOLD — 3
