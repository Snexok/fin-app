    H4["План и записи<br/>/api/profile, /proposals, /entries"]
    H5["Аналитика, напоминания<br/>/api/v1/analytics, /reminders"]
    H6["Webhook /api/telegram<br/>cron /api/cron/*"]
  end
  subgraph L3["3. Общий слой (lib)"]
